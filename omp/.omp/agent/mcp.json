{
  "$schema": "https://raw.githubusercontent.com/can1357/oh-my-pi/main/packages/coding-agent/src/config/mcp-schema.json",
  "mcpServers": {
    "context7": {
      "command": "sh",
      "args": [
        "-c",
        "exec docker compose -f \"$HOME/Code/active/local-mcp/compose.yaml\" run --rm -T context7"
      ]
    },
    "time": {
      "command": "sh",
      "args": [
        "-c",
        "exec docker compose -f \"$HOME/Code/active/local-mcp/compose.yaml\" run --rm -T time"
      ]
    },
    "dockerhub": {
      "enabled": false,
      "command": "sh",
      "args": [
        "-c",
        "exec docker compose -f \"$HOME/Code/active/local-mcp/compose.yaml\" run --rm -T dockerhub"
      ]
    },
    "weather": {
      "command": "sh",
      "args": [
        "-c",
        "exec docker compose -f \"$HOME/Code/active/local-mcp/compose.yaml\" run --rm -T weather"
      ]
    },
    "next-devtools": {
      "enabled": false,
      "command": "sh",
      "args": [
        "-c",
        "exec docker compose -f \"$HOME/Code/active/local-mcp/compose.yaml\" run --rm -T next-devtools"
      ]
    },
    "huggingface": {
      "enabled": false,
      "type": "http",
      "url": "https://huggingface.co/mcp"
    }
  }
}
