* {
    base: #1e1e2e;
    surface: #313244;
    overlay: #45475a;
    text: #cdd6f4;
    muted: #a6adc8;
    pink: #f5c2e7;
    blue: #89b4fa;
    transparent: #00000000;
}

window {
    width: 42%;
    location: center;
    anchor: center;
    background-color: @base;
    border: 2px;
    border-color: @pink;
    border-radius: 18px;
    padding: 18px;
}

mainbox {
    children: [ inputbar, listview ];
    spacing: 14px;
    background-color: @transparent;
}

inputbar {
    children: [ prompt, entry ];
    background-color: @surface;
    border: 1px;
    border-color: @overlay;
    border-radius: 12px;
    padding: 10px 14px;
}

inputbar:focus {
    border-color: @pink;
}

prompt {
    text-color: @pink;
    padding: 0 10px 0 0;
}

entry {
    text-color: @text;
    placeholder: "Search applications";
    placeholder-color: @muted;
}

listview {
    columns: 2;
    lines: 5;
    cycle: true;
    spacing: 8px;
    background-color: @transparent;
}

element {
    background-color: @transparent;
    border-radius: 12px;
    padding: 10px;
}

element selected {
    background-color: @surface;
}

element-icon {
    size: 28px;
    background-color: @transparent;
}

element-text {
    text-color: @text;
    background-color: @transparent;
}

element-text selected {
    text-color: @pink;
}
